# Vorlage für die lokale Konfiguration der LLM-Schicht (ADR 0009, #74).
# Kopieren:  cp .env.beispiel .env   und dann in .env den Schlüssel eintragen.
# .env steht in .gitignore und wird nie eingecheckt. Diese Vorlage enthält keine Geheimnisse.
#
# Entwicklung mit kostenlosen Plänen (ADR 0009, Abschnitt 5a): nur ausgedachte Texte senden,
# die Anbieter können Eingaben zum Training nutzen. Nie echte Nutzerdaten.

# Gemini (Schlüssel aus Google AI Studio)
BUERGERAI_LLM_ANBIETER=gemini
GEMINI_API_KEY=hier-deinen-schluessel-eintragen

# Alternativ Mistral (Plan „Experiment“, in der Konsole unter Privacy das Training ausschalten)
# BUERGERAI_LLM_ANBIETER=mistral
# MISTRAL_API_KEY=hier-deinen-schluessel-eintragen

# Optional:
# BUERGERAI_LLM_MODELL=gemini-2.5-flash-lite     (verfügbare Modelle: ./bai llm --modelle)
# BUERGERAI_LLM_TIMEOUT=20
# BUERGERAI_LLM_VERSUCHE=3
# Nur bei "TLS-Zertifikat nicht prüfbar" im Firmennetz: Datei mit dem Firmenzertifikat (PEM)
# BUERGERAI_LLM_CA_DATEI=/pfad/zum/firmenzertifikat.pem
